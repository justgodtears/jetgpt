    "import json\n",
    "from pathlib import Path\n",
    "\n",
    "raw_data_dir = Path(\"../data/archive/\")\n",
    "\n",
    "total = 0\n",
    "for file in raw_data_dir.iterdir():\n",
    "    with open(file) as f:\n",
    "        total += sum(1 for _ in f)\n",
    "print(total)"
